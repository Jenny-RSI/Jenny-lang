# `std::collections::vec` — Dynamic Contiguous Array (`Vec`)

## 1. Design Intent & Rust `alloc::vec::Vec` Comparison

In Rust's `alloc::vec::Vec<T>`, `push`, `insert`, and `remove` rely on `RawVec<T>`, `ptr::write`, `ptr::read`, `ptr::copy`, and `set_len` inside `unsafe` blocks, with a custom `SetLenOnDrop` guard to maintain exception safety during shifts.

In Jenny's `std::collections::vec`, `Vec` composes `std::mem::raw_buf::RawBuf` via white-box module import (`import std::mem::raw_buf`) and enforces structural and functional invariants declaratively:
- `invariant self.len >= 0 && self.len <= self.buf.cap`
- Automatic $2\times$ geometric reallocation on `push` and `insert_at` via `self.buf.grow(self.len + 1)?`
- Overlapping tail shifts in `insert_at` and `remove_at` via `self.buf.copy_within(...)`
- Deterministic native heap reclamation via `drop_vec(mut self)`, verified at runtime by `active_native_boxes() == 0`.

## 2. Formal Interface & Contracts

```jenny
module std_collections_vec

import std::mem::raw_buf

pub enum VecError {
    EmptyVec,
    IndexOutOfBounds,
    CapacityOverflow,
}

pub struct Vec {
    buf: RawBuf,
    len: i64 = 0,

    invariant self.len >= 0 && self.len <= self.buf.cap
}

impl Vec {
    pub fn new() -> Vec
        effects []
        ensures result.len == 0 && result.buf.cap == 0

    pub fn with_capacity(cap: i64) -> Vec ! VecError
        effects [AllocNative]
        requires cap >= 0 && cap <= 1048576 else VecError.CapacityOverflow
        ensures result.len == 0 && result.buf.cap == cap

    pub fn len(self) -> i64
        effects []
        ensures result == self.len

    pub fn capacity(self) -> i64
        effects []
        ensures result == self.buf.cap

    pub fn is_empty(self) -> bool
        effects []
        ensures result == (self.len == 0)

    pub fn reserve(mut self, additional: i64) -> i64 ! VecError
        effects [Mutate, AllocNative]
        requires additional >= 0 && self.len + additional <= 1048576 else VecError.CapacityOverflow
        ensures self.buf.cap >= self.len + additional && self.len == old(self.len)

    pub fn push(mut self, val: i64) -> i64 ! VecError
        effects [Mutate, AllocNative]
        requires self.len < 1048576 else VecError.CapacityOverflow
        ensures self.len == old(self.len) + 1 && self.buf.cap >= self.len

    pub fn pop(mut self) -> i64 ! VecError
        effects [Mutate]
        requires self.len > 0 else VecError.EmptyVec
        ensures self.len == old(self.len) - 1

    pub fn get(self, idx: i64) -> i64 ! VecError
        effects []
        requires idx >= 0 && idx < self.len else VecError.IndexOutOfBounds

    pub fn set(mut self, idx: i64, val: i64) -> i64 ! VecError
        effects [Mutate]
        requires idx >= 0 && idx < self.len else VecError.IndexOutOfBounds
        ensures self.len == old(self.len)

    pub fn insert_at(mut self, idx: i64, val: i64) -> i64 ! VecError
        effects [Mutate, AllocNative]
        requires idx >= 0 && idx <= self.len else VecError.IndexOutOfBounds
        requires self.len < 1048576 else VecError.CapacityOverflow
        ensures self.len == old(self.len) + 1

    pub fn remove_at(mut self, idx: i64) -> i64 ! VecError
        effects [Mutate]
        requires idx >= 0 && idx < self.len else VecError.IndexOutOfBounds
        ensures self.len == old(self.len) - 1

    pub fn clear(mut self) -> i64
        effects [Mutate]
        ensures self.len == 0 && self.buf.cap == old(self.buf.cap)

    pub fn drop_vec(mut self) -> i64
        effects [Mutate, AllocNative]
        ensures self.len == 0 && self.buf.cap == 0
}

@example("EX-STD-VEC-01: Vec 2x geometric growth, insert_at, remove_at, pop, and zero-leak drop") {
    var v = Vec.new()
    assert(v.is_empty())
    assert(v.capacity() == 0)
    v.push(10)!
    v.push(20)!
    v.push(30)!
    v.push(40)!
    v.push(50)!
    assert(v.len() == 5)
    assert(v.capacity() == 8)
    v.insert_at(2, 25)!
    assert(v.len() == 6)
    assert(v.get(2)! == 25)
    assert(v.get(3)! == 30)
    val removed = v.remove_at(1)!
    assert(removed == 20)
    assert(v.len() == 5)
    assert(v.get(1)! == 25)
    val last = v.pop()!
    assert(last == 50)
    assert(v.len() == 4)
    v.drop_vec()
    assert(active_native_boxes() == 0)
}

@example("EX-STD-VEC-02: Vec rejects pop on empty and out-of-bounds get/insert/remove") {
    var v = Vec.with_capacity(4)!
    val e1 = v.pop()
    assert(e1 is Err(VecError.EmptyVec))
    v.push(99)!
    val e2 = v.get(1)
    assert(e2 is Err(VecError.IndexOutOfBounds))
    val e3 = v.insert_at(3, 77)
    assert(e3 is Err(VecError.IndexOutOfBounds))
    v.drop_vec()
    assert(active_native_boxes() == 0)
}
```
