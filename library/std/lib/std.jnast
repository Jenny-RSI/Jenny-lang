          "key": "CFrameHeader.new",
          "name": "new",
          "struct_owner": "CFrameHeader",
          "is_spin_variadic": false,
          "params": [
            {
              "name": "version",
              "ty": "u32",
              "mode": "borrow"
            },
            {
              "name": "ihl",
              "ty": "u32",
              "mode": "borrow"
            },
            {
              "name": "dscp",
              "ty": "u32",
              "mode": "borrow"
            },
            {
              "name": "ecn",
              "ty": "u32",
              "mode": "borrow"
            },
            {
              "name": "total_len",
              "ty": "u32",
              "mode": "borrow"
            },
            {
              "name": "seq_id",
              "ty": "u32",
              "mode": "borrow"
            }
          ],
          "ret_ty": "CFrameHeader",
          "err_ty": "CAbiError",
          "effects": [],
          "requires": [
            "version >= 4 && version <= 15",
            "ihl >= 5 && ihl <= 15",
            "dscp >= 0 && dscp <= 63",
            "ecn >= 0 && ecn <= 3",
            "total_len >= 20 && total_len <= 65535",
            "total_len >= ihl * 4"
          ],
          "ensures": [
            "result.version == version && result.ihl == ihl",
            "result.dscp == dscp && result.ecn == ecn",
            "result.total_len == total_len && result.seq_id == seq_id"
          ],
          "body_stmts": [
            "return CFrameHeader {",
            "version: version,",
            "ihl: ihl,",
            "dscp: dscp,",
            "ecn: ecn,",
            "total_len: total_len,",
            "seq_id: seq_id,",
            "}"
          ]
        },
