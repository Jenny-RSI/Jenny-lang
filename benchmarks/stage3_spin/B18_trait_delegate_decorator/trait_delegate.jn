module trait_delegate

impl MemKvStore {
    pub fn new(s0: i64, s1: i64, s2: i64, s3: i64) -> MemKvStore {
        return MemKvStore { s0: s0, s1: s1, s2: s2, s3: s3, writes: 0 }
    }

    pub fn read_slot(self, slot: i64) -> i64 {
        return match slot {
            0 => self.s0,
            1 => self.s1,
            2 => self.s2,
            _ => self.s3,
        }
    }

    pub fn write_slot(mut self, slot: i64, val_data: i64) -> void {
        self.writes += 1
        if slot == 0 {
            self.s0 = val_data
        } else if slot == 1 {
            self.s1 = val_data
        } else if slot == 2 {
            self.s2 = val_data
        } else {
            self.s3 = val_data
        }
    }

    pub fn capacity(self) -> i64 {
        return 4
    }

    pub fn checksum(self) -> i64 {
        return self.s0 + self.s1 + self.s2 + self.s3
    }

    pub fn reset_all(mut self) -> void {
        self.s0 = 0
        self.s1 = 0
        self.s2 = 0
        self.s3 = 0
    }
}

impl AuditedKvDecorator {
    pub fn new(s0: i64, s1: i64, s2: i64, s3: i64) -> AuditedKvDecorator {
        val store = MemKvStore.new(s0, s1, s2, s3)
        return AuditedKvDecorator { inner: store, audit_reads: 0, audit_writes: 0 }
    }

    pub fn read_slot(mut self, slot: i64) -> i64 {
        self.audit_reads += 1
        return self.inner.read_slot(slot)
    }

    pub fn write_slot(mut self, slot: i64, val_data: i64) -> void {
        self.audit_writes += 1
        self.inner.write_slot(slot, val_data)
    }
}

pub fn inspect_engine_digest(engine: dyn KvEngine) -> i64 {
    return engine.capacity() * 100 + engine.checksum()
}
