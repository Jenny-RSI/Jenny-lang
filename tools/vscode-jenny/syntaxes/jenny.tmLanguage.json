{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Jenny",
  "scopeName": "source.jenny",
  "patterns": [
    { "include": "#comments" },
    { "include": "#illegal-v2" },
    { "include": "#annotations" },
    { "include": "#contracts" },
    { "include": "#ownership-modes" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#identifiers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.jenny",
          "match": "//.*$"
        },
        {
          "name": "comment.block.jenny",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "illegal-v2": {
      "patterns": [
        {
          "name": "invalid.illegal.reference.jenny",
          "match": "&\\s*(mut\\b|self\\b)"
        },
        {
          "name": "invalid.illegal.let.jenny",
          "match": "\\blet\\b"
        }
      ]
    },
    "annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.jenny",
          "match": "@(spin|example|apply|repr|export|operator|scoped|non_suspendable)\\b"
        }
      ]
    },
    "contracts": {
      "patterns": [
        {
          "name": "keyword.control.contract.jenny",
          "match": "\\b(requires|ensures|invariant|effects|mask)\\b"
        },
        {
          "name": "variable.language.contract.jenny",
          "match": "\\b(old|result)\\b"
        }
      ]
    },
    "ownership-modes": {
      "patterns": [
        {
          "name": "storage.modifier.ownership.jenny",
          "match": "\\b(mut|own)\\b"
        },
        {
          "name": "variable.language.self.jenny",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.jenny",
          "match": "\\b(if|else|match|guard|is|for|in|while|return|raise|catch|yield|await)\\b"
        },
        {
          "name": "keyword.other.declaration.jenny",
          "match": "\\b(module|pub|pkg|import|fn|iter|val|var|struct|enum|error|trait|impl|delegate|dsl|quote|as|test)\\b"
        },
        {
          "name": "constant.language.jenny",
          "match": "\\b(true|false|null)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.jenny",
          "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|str|String|usize|void|AnyError)\\b"
        },
        {
          "name": "entity.name.type.jenny",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.jenny",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jenny",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.jenny",
          "match": "\\b(0x[0-9a-fA-F_]+|[0-9][0-9_]*(\\.[0-9_]+)?)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.pipe.jenny",
          "match": "\\|>"
        },
        {
          "name": "keyword.operator.null-coalesce.jenny",
          "match": "\\?\\?"
        },
        {
          "name": "keyword.operator.error.jenny",
          "match": "->|=>|!|\\?"
        },
        {
          "name": "keyword.operator.Pointer.jenny",
          "match": "[*^]"
        },
        {
          "name": "keyword.operator.comparison.jenny",
          "match": "==|!=|<=|>=|<|>|&&|\\|\\|"
        },
        {
          "name": "keyword.operator.assignment.jenny",
          "match": "\\+=|-=|\\*=|/=|="
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.other.declaration.jenny" },
            "2": { "name": "entity.name.function.jenny" }
          }
        },
        {
          "match": "\\b([a-z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.jenny" }
          }
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.jenny",
          "match": "\\b[a-z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
