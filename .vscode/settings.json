{
  "files.associations": {
    "*.jni": "markdown",
    "*.jn": "jenny",
    "*.spun.jn": "jenny"
  },
  "[markdown]": {
    "editor.quickSuggestions": {
      "comments": "on",
      "strings": "on",
      "other": "on"
    }
  },
  "[jenny]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  }
}
